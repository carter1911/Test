{
  "name": "ai-revenue-analyst",
  "version": "1.0.0",
  "description": "AI Revenue & Operations Analyst for service-based businesses - Cloudflare Workers Edition",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --outfile=dist/worker.js --format=esm --target=es2022",
