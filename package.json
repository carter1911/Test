    "secret:huggingface": "wrangler secret put HUGGINGFACE_API_KEY"
  },
  "keywords": [
    "cloudflare-workers",
    "ai",
    "revenue-analytics",
    "huggingface",
    "operations"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3",
    "wrangler": "^3.80.0"
  },
  "dependencies": {}
}
